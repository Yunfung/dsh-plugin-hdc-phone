{
  "name": "dsh-plugin-hdc-phone",
  "version": "0.3.1",
  "description": "Drive a second phone through a local HTTP hdc bridge (HdcBridge / DSH NEXT): observe/tap/swipe/key/input/launch, with configurable bridge host/port.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "cordis-plugin",
    "harmonyos",
    "openharmony",
    "hdc",
    "phone",
    "remote-control"
  ],
  "license": "MIT",
  "author": "moyuge123",
  "homepage": "https://github.com/Yunfung/dsh-plugin-hdc-phone#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yunfung/dsh-plugin-hdc-phone.git"
  },
  "bugs": {
    "url": "https://github.com/Yunfung/dsh-plugin-hdc-phone/issues"
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    }
  }
}
